    family-names: Guenena
    email: yusuf.a.guenena@gmail.com
repository-code: "https://github.com/yusufdxb/ipfd"
url: "https://github.com/yusufdxb/ipfd"
license: MIT
version: 1.1.0.dev0
keywords:
